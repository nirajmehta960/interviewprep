# --- Supabase (client-safe) -------------------------------------------------
# NEXT_PUBLIC_ is Next.js's marker for values that may reach the browser.
NEXT_SUPABASE_URL=
NEXT_SUPABASE_PROJECT_ID=
NEXT_SUPABASE_ANON_KEY=

# --- Postgres (SERVER ONLY — never prefix these with NEXT_PUBLIC_) ----------
# Copy both from: Supabase dashboard -> Project Settings -> Database ->
# Connection string. Use the "Transaction" pooler for DATABASE_URL and the
# "Session"/direct connection for DIRECT_URL. Replace [YOUR-PASSWORD].
#
# Prisma runs queries through the pooler and migrations through the direct
# connection, because migrations cannot run over PgBouncer.
#
# DATABASE_URL=
# DIRECT_URL=
